{
  "base_url": "https://github.com/smirnovhub/my-mikrotik-scripts/raw/refs/heads/master/",
  "method": "DownloadAndImportScriptsFromList",
  "config": [
    {
      "alg": "md5",
      "list": "global/list.txt",
      "path": "global",
      "pattern": "*.rsc",
      "list_exclude": [
        "global_config.rsc"
      ],
      "setup_file": "global/global_setup.rsc"
    },
    {
      "alg": "md5",
      "list": "global/tests/list.txt",
      "path": "global/tests",
      "pattern": "*.rsc",
      "setup_file": "global/tests/global_setup_tests.rsc"
    },
    {
      "alg": "md5",
      "list": "other/list.txt",
      "path": "other",
      "pattern": "*.rsc",
      "recursive": true
    },
    {
      "alg": "crc32",
      "list": "global/tests/test_data/test_list_crc32.txt",
      "files": [
        "global/tests/test_data/test_string1.txt",
        "global/tests/test_data/test_string2.txt",
        "global/tests/test_data/test_string3.txt"
      ]
    },
    {
      "alg": "md5",
      "list": "global/tests/test_data/test_list_md5.txt",
      "files": [
        "global/tests/test_data/test_string1.txt",
        "global/tests/test_data/test_string2.txt",
        "global/tests/test_data/test_string3.txt"
      ]
    },
    {
      "alg": "sha1",
      "list": "global/tests/test_data/test_list_sha1.txt",
      "files": [
        "global/tests/test_data/test_string1.txt",
        "global/tests/test_data/test_string2.txt",
        "global/tests/test_data/test_string3.txt"
      ]
    },
    {
      "alg": "sha256",
      "list": "global/tests/test_data/test_list_sha256.txt",
      "files": [
        "global/tests/test_data/test_string1.txt",
        "global/tests/test_data/test_string2.txt",
        "global/tests/test_data/test_string3.txt"
      ]
    },
    {
      "alg": "sha512",
      "list": "global/tests/test_data/test_list_sha512.txt",
      "files": [
        "global/tests/test_data/test_string1.txt",
        "global/tests/test_data/test_string2.txt",
        "global/tests/test_data/test_string3.txt"
      ]
    },
    {
      "alg": "md5",
      "list": "global/tests/test_data/auto_update_test_list.txt",
      "files": [
        "global/tests/test_data/auto_update_test_script.rsc"
      ]
    }
  ]
}
